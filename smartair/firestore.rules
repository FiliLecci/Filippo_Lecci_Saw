rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /stations/{stationId} {
      // Puoi leggere una stazione solo se sei nella lista utenti
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/stations/$(stationId));
      // Puoi crearla solo se sei il proprietario
      allow write: if request.auth != null && 
        request.resource.data.owner == request.auth.uid;
    }

    match /stations/{stationId}/readings/{readingId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/stations/$(stationId));
      allow write: if false; // solo la Cloud Function scrive le letture
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}